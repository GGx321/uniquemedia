{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["engine/**/*", "montage/**/*", "text/**/*", "music/**/*", "autopilot/**/*"],
  "exclude": ["engine/**/*.test.ts", "engine/**/*.test.tsx", "montage/**/*.test.ts", "montage/**/*.testkit.ts", "text/**/*.test.ts", "music/**/*.test.ts", "autopilot/**/*.test.ts"]
}
