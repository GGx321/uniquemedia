{
  "name": "uniquemedia",
  "version": "0.6.0",
  "type": "module",
  "main": "out/main/main.js",
  "bin": {
    "uniquify": "./src/cli.ts"
  },
  "scripts": {
    "test": "bun test",
    "uniquify": "bun run src/cli.ts",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dev:studio": "electron-vite dev -c electron.studio.vite.config.ts --entry out-studio/main/main.js",
    "models:face": "bun run studio/scripts/faceModelCache.ts",
    "typecheck:studio": "tsc --noEmit -p studio/tsconfig.json && tsc --noEmit -p studio/shared/tsconfig.json",
    "test:studio:electron-node": "bun studio/scripts/electronNodeTests.ts",
    "test:studio:suite": "bun studio/scripts/realWorkerTests.ts --shards=3 --suite",
    "test:studio:suite:canary": "bun studio/scripts/realWorkerTests.ts --known-crashes-only --shards=3 --suite",
    "build:studio": "STUDIO_E2E=0 electron-vite build -c electron.studio.vite.config.ts && bun run studio/scripts/prepareFaceAssets.ts && bun run studio/scripts/prepareTextAssets.ts",
    "build:studio:e2e": "STUDIO_E2E=1 electron-vite build -c electron.studio.vite.config.ts && bun run studio/scripts/prepareFaceAssets.ts && bun run studio/scripts/prepareTextAssets.ts",
    "dist:studio": "bun run build:studio && electron-builder --config electron-builder.studio.yml",
    "dist:studio:mac": "bun run build:studio && electron-builder --config electron-builder.studio.yml --mac",
    "dist:studio:mac:e2e": "bun run build:studio:e2e && electron-builder --config electron-builder.studio.yml --mac dir -c.directories.output=release-studio/e2e -c.appId=com.uniquemedia.studio.e2e -c.productName=\"Studio E2E\" -c.extraMetadata.name=uniquemedia-studio-e2e -c.extraMetadata.productName=\"Studio E2E\"",
    "dist:studio:win": "bun run build:studio && electron-builder --config electron-builder.studio.yml --win",
    "dist:studio:win:e2e": "bun run build:studio:e2e && electron-builder --config electron-builder.studio.yml --win dir -c.directories.output=release-studio/e2e -c.appId=com.uniquemedia.studio.e2e -c.productName=\"Studio E2E\" -c.extraMetadata.name=uniquemedia-studio-e2e -c.extraMetadata.productName=\"Studio E2E\""
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.2.10",
    "@fontsource-variable/hanken-grotesk": "^5.2.8",
    "@fontsource-variable/martian-mono": "^5.2.7",
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/png": "3.1.1",
    "exiftool-vendored": "^36.0.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "onnxruntime-web": "1.30.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@fontsource-variable/geologica": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@happy-dom/global-registrator": "^20.10.2",
    "@resvg/resvg-wasm": "2.6.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.4.2",
    "@types/ffprobe-static": "^2.0.3",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.0",
    "electron-vite": "^5.0.0",
    "typescript": "^5.6.0",
    "vite": "^8.0.16",
    "zod": "^4.6.5"
  },
  "trustedDependencies": ["electron", "ffmpeg-static", "ffprobe-static"]
}
