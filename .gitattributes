# The generated sticker set is compared byte for byte with a fresh generation,
# so Git must never rewrite its line endings (Git for Windows would turn
# catalog.json into CRLF on checkout).
studio/assets/stickers/** -text

# The pinned prompt fixtures are compared word for word with the prompt the code
# builds (LF), so Git must not turn them into CRLF on a Windows checkout either.
studio/engine/**/fixtures/*-system-prompt.txt -text
